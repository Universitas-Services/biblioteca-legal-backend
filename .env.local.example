# Copia a .env.local para desarrollo local (no commitear)
# npm run prisma:migrate:local usa esta URL por defecto vía scripts/run-prisma-local.mjs

DATABASE_URL="postgresql://admin:rootpassword@localhost:5434/universitas"

JWT_SECRET="change-me-local"

GCP_PROJECT_ID="tu-proyecto-gcp"
GCP_KEY_FILE_PATH="./credentials/tu-clave.json"
GCP_STORAGE_BUCKET_NAME="tu-bucket"

CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

RESEND_API_KEY=tu_api_key_de_resend
EMAIL_FROM=no-reply@tudominio.com
FRONTEND_URL=http://localhost:3000
