generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role       @default(CLIENTE)
  auditLogs AuditLog[]
}

model Documento {
  id                  String     @id @default(uuid())
  titulo              String
  archivoOriginalUrl  String
  estado              String     @default("Pendiente de Revisión")
  ultimaActualizacion DateTime   @updatedAt

  soloLecturaImagen   Boolean    @default(false)
  nombreBreve         String?
  temaPrincipal       String?
  categorias          String[]
  etiquetas           String[]
  tipoNorma           String?
  enteEmisor          String?
  fechaPublicacion    String?
  numeroGaceta        String?
  
  esReforma           Boolean    @default(false)
  reformaAId          String?
  reformaA            Documento? @relation("ReformasRelation", fields: [reformaAId], references: [id])
  reformas            Documento[] @relation("ReformasRelation")

  matrizAElementos    String[]
  matrizBElementos    String[]
  resumen             String?
  palabrasClave       String[]

  eliminado           Boolean    @default(false)
  fechaEliminacion    DateTime?

  auditLogs           AuditLog[]
}

model AuditLog {
  id          String     @id @default(uuid())
  accion      String
  fecha       DateTime   @default(now())
  userId      String
  documentoId String?
  documento   Documento? @relation(fields: [documentoId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
}

enum Role {
  CLIENTE
  CURADOR
  REVISOR
  AUDITOR
  ADMIN
}
