generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  CURADOR
  REVISOR
  AUDITOR
  ADMIN
}

enum EstadoDocumento {
  PENDIENTE_REVISION
  VIGENTE
  REFORMADA
  DEROGADA
}

enum EstadoCategoria {
  SUGERIDA
  APROBADA
}

enum Profesion {
  ABOGADO
  NOTARIO
  JUEZ
  FISCAL
  DEFENSOR
  ESTUDIANTE_DERECHO
  ACADEMICO
  CONSULTOR_LEGAL
  OTRO
}

enum TipoNotificacion {
  REFORMADA
  DEROGADA
}

enum TipoSolucion {
  CURSO
  MODELO_DESCARGABLE
  EVENTO
}

// ──────────────────────────────────────────────────────────────────────────────
// Modelos de estructura de carpetas en Google Cloud Storage
// ──────────────────────────────────────────────────────────────────────────────

/// Representa un tema principal de la biblioteca legal.
/// Cada registro está sincronizado con una carpeta simulada en GCS:
///   gs://bucket/tema-principal/{slug}/
model TemaPrincipal {
  id          String            @id @default(uuid())
  nombre      String            @unique // Nombre original (ej: "Contrataciones Públicas")
  slug        String            @unique // Nombre formateado (ej: "contrataciones-publicas")
  gcsUri      String            // URI nativa de la carpeta en GCS
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  subcarpetas SubcarpetaNorma[] // Relación 1:N con los tipos de norma
  revisores   User[]            @relation("RevisorTemas") // Revisores asignados a este tema
}

/// Representa un tipo de norma dentro de un tema principal.
/// Cada registro está sincronizado con una carpeta simulada en GCS:
///   gs://bucket/tema-principal/{temaSlug}/{slug}/
model SubcarpetaNorma {
  id              String        @id @default(uuid())
  nombre          String        // Nombre original (ej: "Ley Orgánica")
  slug            String        // Nombre formateado (ej: "ley-organica")
  gcsUri          String        // URI nativa de la carpeta en GCS
  temaPrincipalId String        // FK al tema padre
  temaPrincipal   TemaPrincipal @relation(fields: [temaPrincipalId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Un mismo tipo de norma no puede repetirse dentro del mismo tema
  @@unique([temaPrincipalId, slug])
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  password             String
  role                 Role                @default(CLIENTE)
  nombre               String?
  apellido             String?
  telefono             String?
  pais                 String?
  profesion            Profesion?
  nivelMuro            Int                 @default(0)
  tokenVersion         Int                 @default(0)
  consultasRealizadas  Int                 @default(0)
  temasAsignados       TemaPrincipal[]     @relation("RevisorTemas") // Solo para REVISOR
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  auditLogs            AuditLog[]
  favoritos            Favorito[]
  historialConsultas   HistorialConsulta[]
  comentariosInternos  ComentarioInterno[]
  notificaciones       Notificacion[]
  documentosCurados    Documento[]         @relation("CuradorDocumentos")
  documentosRevisados  Documento[]         @relation("RevisorDocumentos")
  categoriasSugeridas  Categoria[]
}

model Documento {
  id                  String           @id @default(uuid())
  titulo              String
  tituloIntegro       String
  archivoOriginalUrl  String
  estado              EstadoDocumento  @default(PENDIENTE_REVISION)
  ultimaActualizacion DateTime         @updatedAt
  createdAt           DateTime         @default(now())

  soloLecturaImagen Boolean  @default(false)
  nombreBreve       String?
  temaPrincipal     String?
  etiquetas         String[]
  tipoNorma         String?
  enteEmisor        String?
  fechaPublicacion  String?
  numeroGaceta      String?

  esReforma     Boolean    @default(false)
  reformaAId    String?
  reformaA      Documento? @relation("ReformasRelation", fields: [reformaAId], references: [id])
  reformas      Documento[] @relation("ReformasRelation")

  resumen       String?
  palabrasClave String[]

  eliminado        Boolean   @default(false)
  fechaEliminacion DateTime?

  curadorId          String?
  curador            User?   @relation("CuradorDocumentos", fields: [curadorId], references: [id])
  revisorAsignadoId  String?
  revisorAsignado    User?   @relation("RevisorDocumentos", fields: [revisorAsignadoId], references: [id])

  matrizAId String?
  matrizA   MatrizA? @relation(fields: [matrizAId], references: [id])
  matrizB   MatrizB[] @relation("DocumentoMatrizB")

  categorias          Categoria[]
  auditLogs           AuditLog[]
  favoritos           Favorito[]
  historialConsultas  HistorialConsulta[]
  comentariosInternos ComentarioInterno[]
  notificaciones      Notificacion[]

  @@index([tituloIntegro, enteEmisor, fechaPublicacion])
}

model Categoria {
  id           String          @id @default(uuid())
  nombre       String          @unique
  estado       EstadoCategoria @default(SUGERIDA)
  sugeridoPorId String?
  sugeridoPor  User?           @relation(fields: [sugeridoPorId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  documentos   Documento[]
}

/// Catálogo de Productos y Formación de Universitas.
/// Alimenta las sugerencias laterales de la vista de documento (Producto/Curso).
model MatrizA {
  id                 String       @id @default(uuid())
  nombreProducto     String       // Nombre comercial (ej. "Curso de Gestión Pública")
  tipoSolucion       TipoSolucion // Clasificador cerrado: CURSO, MODELO_DESCARGABLE, EVENTO
  urlDestino         String       // Enlace de salida hacia la pasarela externa de Universitas
  categoriasKeywords String[]     // Etiquetas temáticas para el algoritmo de match
  activo             Boolean      @default(true) // Control de visualización (ADMIN puede editar)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  documentos         Documento[]
}

/// Repositorio de Ágora / Lecturas Recomendadas.
/// Alimenta las sugerencias laterales de la vista de documento (Artículos del blog).
model MatrizB {
  id                 String     @id @default(uuid())
  tituloArticulo     String     // Título exacto renderizado como texto hipervinculado
  autorArticulo      String     // Nombre del especialista o doctrinario
  urlDestinoAgora    String     // Enlace directo a la entrada en el blog WordPress (Ágora)
  categoriasKeywords String[]   // Etiquetas temáticas para el match semántico
  activo             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  documentos         Documento[] @relation("DocumentoMatrizB")
}

model HistorialConsulta {
  id          String    @id @default(uuid())
  userId      String
  documentoId String
  fecha       DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Favorito {
  id          String    @id @default(uuid())
  userId      String
  documentoId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([userId, documentoId])
}

model ComentarioInterno {
  id          String    @id @default(uuid())
  texto       String
  autorId     String
  documentoId String
  fecha       DateTime  @default(now())
  autor       User      @relation(fields: [autorId], references: [id])
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
}

model Notificacion {
  id          String           @id @default(uuid())
  userId      String
  documentoId String
  tipo        TipoNotificacion
  mensaje     String
  leida       Boolean          @default(false)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documento   Documento        @relation(fields: [documentoId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String     @id @default(uuid())
  accion      String
  detalle     String?
  fecha       DateTime   @default(now())
  userId      String
  documentoId String?
  documento   Documento? @relation(fields: [documentoId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
}
